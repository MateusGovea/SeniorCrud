# Docker Compose - SQL Server
SQL_SA_PASSWORD=Your_password123

# Docker Compose - JWT Secret
# Optional in local development: if the API container finds no strong
# JWT_SECRET_KEY, it auto-generates a random secret (64 bytes) on first start
# and persists it in a named volume (jwt_dev_secret), keeping logins valid
# across restarts. The known placeholder below is never used as a signing key.
#
# For production, ALWAYS set your own strong secret (at least 32 bytes), e.g.:
#   openssl rand -base64 48   (Linux/macOS/WSL)
#   powershell -Command "[Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes(64))"
JWT_SECRET_KEY=CHANGE_ME_WITH_A_STRONG_SECRET
