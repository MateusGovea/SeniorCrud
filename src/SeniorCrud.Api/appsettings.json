{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SeniorCrudDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "SeniorCrud",
    "Audience": "SeniorCrud.Client",
    "AccessTokenMinutes": 15
  },
  "ViaCep": {
    "BaseUrl": "https://viacep.com.br",
    "TimeoutSeconds": 2,
    "RetryCount": 3
  },
  "Cache": {
    "CepAbsoluteExpirationHours": 24,
    "CepNegativeCacheMinutes": 5
  },
  "Csv": {
    "Delimiter": ",",
    "Encoding": "utf-8"
  },
  "OpenTelemetry": {
    "ServiceName": "SeniorCrud.Api"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log-.txt", "rollingInterval": "Day" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
